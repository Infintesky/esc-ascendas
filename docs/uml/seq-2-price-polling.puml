@startuml seq-2-price-polling
' UC2: Browse hotel results, progressive price polling.
' One of the two UML attach points named in the spec (section 6).
title UC2: Results & Progressive Price Polling
autonumber

actor Guest
participant "SearchPage\n<<server component>>" as Page
participant "SearchResults\n<<async server component>>" as SR
participant "PricesProvider\n<<client, context>>" as PP
participant "useHotelPrices\n<<hook>>" as Hook
participant "ResultsView\n<<client>>" as RV
participant "PricesController\n/api/hotels/prices" as Ctrl
participant "AscendaClient" as Client
participant "AscendaMappers" as Map
actor "Ascenda Hotel API\n(hotelapi.loyalty.dev)" as Ascenda

== Static hotels (server-rendered, cached; awaited in Suspense) ==
Guest -> Page : GET /search?<params>
activate Page
Page -> SR : render <SearchResults destinationId query />  (inside <Suspense>)
activate SR
SR -> Client : ascendaGet(/api/hotels?destination_id) [revalidate 24h]
activate Client
Client -> Ascenda : GET /api/hotels
activate Ascenda
Ascenda --> Client : raw hotel JSON[]
deactivate Ascenda
Client --> SR : raw[]
deactivate Client
SR -> Map : raw.map(mapHotel)
activate Map
Map --> SR : Hotel[]
deactivate Map
SR -> RV : mount <ResultsView hotels query />
deactivate SR
activate RV
RV --> Guest : render initial hotel list (prices pending)
note over Page, PP : PricesProvider sits OUTSIDE the Suspense boundary,\nso its polling starts independently of, and doesn't wait for, SearchResults above.\n(Shown here as sequential for readability; the two are actually concurrent.)
Page -> PP : mount <PricesProvider query>
activate PP
PP -> Hook : useHotelPrices(query)
activate Hook
Hook --> PP : { hotels: [], completed: false }  (initial state, before first poll)
PP --> Page : mounted (polling started)
deactivate PP
deactivate Page

== Client-owned poll loop (progressive render) ==
loop until completed OR polls >= MAX_POLLS (26, ~40s)
  Hook -> Ctrl : GET /api/hotels/prices?<query>
  activate Ctrl
  Ctrl -> Ctrl : SearchParamsSchema.safeParse() (Zod)
  alt invalid params
    Ctrl --> Hook : 400 invalid search params  (res.ok === false)
  else valid
    Ctrl -> Client : buildPricesUrl(+stub partner/landing/product)
    activate Client
    Client --> Ctrl : url
    deactivate Client
    Ctrl -> Ctrl : getCached(url)
    alt cache hit (completed result, < 5 min old)
      note right of Ctrl : short-circuits the upstream round trip entirely
    else cache miss
      Ctrl -> Client : ascendaGet(url, { cache: "no-store" })
      activate Client
      Client -> Ascenda : GET /api/hotels/prices (no-store)
      activate Ascenda
      Ascenda --> Client : raw (partial or completed)
      deactivate Ascenda
      Client --> Ctrl : raw
      deactivate Client
      Ctrl -> Map : mapPricesResponse(raw)
      activate Map
      Map --> Ctrl : PricesResponse
      deactivate Map
      opt PricesResponse.completed
        Ctrl -> Ctrl : cache.set(url, { at: now, data })  (TTL 5 min)
      end
    end
    Ctrl --> Hook : 200 { completed, hotels[] }
  end
  deactivate Ctrl
  alt res.ok === false  (400 above, upstream 5xx, or fetch/network error)
    Hook -> Hook : catch(e) -> setError(e.message)
    Hook -> RV : context update { hotels: [], completed: false, error }
    RV --> Guest : show error state
    break
      note right of Hook : catch block never calls setTimeout(poll, ..) again:\npolling silently stops here (completed stays false)
    end
  else res.ok === true
    Hook -> Hook : merge by id (latest wins), setHotels()
    Hook -> RV : context update { hotels, completed }
    RV -> RV : mergeHotelsWithPrices + applyFilters + sortListings
    RV --> Guest : render/refresh HotelCards + streaming progress bar
    opt not completed
      Hook -> Hook : setTimeout(poll, polls < FAST_POLLS(8) ? 600ms : 2000ms)
    end
  end
end
deactivate Hook
Guest -> RV : click "Select" on a hotel
RV --> Guest : navigate /hotels/:id?<query>  (UC3)
deactivate RV
@enduml
